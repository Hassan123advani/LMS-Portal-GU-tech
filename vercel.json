{
  "services": {
    "frontend": {
      "root": "Front end/"
    },
    "backend": {
      "root": "Back end/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}